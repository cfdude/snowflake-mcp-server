# Snowflake MCP Server Configuration
# ====================================
# Copy to .env and fill in your values.
# Only settings listed here are read by the server.

# ==============================================================================
# Snowflake Connection (required)
# ==============================================================================

# Authentication: "private_key" (service accounts) or "external_browser" (SSO)
SNOWFLAKE_AUTH_TYPE=private_key

# Account identifier (e.g., "ou15116" or "myorg-account123")
SNOWFLAKE_ACCOUNT=your-account-id

# Username
SNOWFLAKE_USER=your-username

# Warehouse, database, schema, role
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=your-role

# Path to RSA private key (.pem) — only needed for private_key auth
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/your/private_key.pem

# ==============================================================================
# Connection Pool
# ==============================================================================

SNOWFLAKE_POOL_MIN_SIZE=2
SNOWFLAKE_POOL_MAX_SIZE=10
SNOWFLAKE_POOL_MAX_INACTIVE_MINUTES=30
SNOWFLAKE_POOL_HEALTH_CHECK_MINUTES=5
SNOWFLAKE_POOL_CONNECTION_TIMEOUT=30.0
SNOWFLAKE_POOL_RETRY_ATTEMPTS=3

# ==============================================================================
# HTTP Server (for PM2 / Claude Code — not used in STDIO mode)
# ==============================================================================

MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_HTTP_REQUEST_TIMEOUT=300

# ==============================================================================
# Security
# ==============================================================================

# Allowed SQL commands — JSON array format required
# Read-only default. Add "create","insert","update" only if you trust all users.
ALLOWED_SQL_COMMANDS=["select","show","describe","explain","with","union","use"]

# Lock to read-only (blocks INSERT, UPDATE, CREATE, etc.)
READONLY_MODE=true

# ==============================================================================
# Output Configuration for Large Query Results
# ==============================================================================
#
# The server estimates whether query results will exceed the AI model's token
# limit and automatically routes large results to file output (CSV/JSON).
#
# Model token limits (2026):
#   claude-opus-4-6:    1,000,000 tokens
#   claude-sonnet-4-6:    200,000 tokens
#   gpt-4.1:            1,000,000 tokens
#   gemini-2.5-pro:     2,000,000 tokens
#
# ~1 token ≈ 4 characters. 1M tokens ≈ 4MB text.

MODEL_NAME=claude-opus-4-6
MODEL_CONTEXT_TOKEN_LIMIT=1000000
MODEL_SAFETY_MARGIN=0.7

# Output mode: auto (recommended) | screen | file
DEFAULT_OUTPUT=auto

# File format for file output: csv | json
DEFAULT_FILE_FORMAT=csv

# Directory for file output. Relative paths resolve from MCP_CLIENT_ROOT.
# MCP_CLIENT_ROOT is set by the calling client (e.g., Claude Desktop).
DEFAULT_OUTPUT_DIR=./query_results

# Results exceeding this row count auto-route to file output
SCREEN_OUTPUT_ROW_THRESHOLD=1000

# Auto-generate filenames using pattern below
AUTO_GENERATE_FILENAME=true
FILENAME_PATTERN=query_{date}_{time}

# Token estimation tuning (internal)
TOKEN_ESTIMATION_SAMPLE_SIZE=100
LOG_TOKEN_ESTIMATION=false
